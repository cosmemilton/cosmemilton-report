{
  "name": "cosmemilton-report",
  "version": "0.0.0",
  "description": "Report builder React para Next.js — definição declarativa de relatórios com export em PDF, CSV, XLSX, JSON e TSV, editor visual de layout e config em camadas.",
  "author": "Cosme Milton <milton.cosme@gmail.com>",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cosmemilton/cosmemilton-report.git"
  },
  "bugs": {
    "url": "https://github.com/cosmemilton/cosmemilton-report/issues"
  },
  "keywords": [
    "react",
    "nextjs",
    "report",
    "report-builder",
    "pdf",
    "csv",
    "xlsx",
    "relatorio",
    "cosmemilton"
  ],
  "type": "module",
  "style": "./dist/styles.css",
  "files": [
    "dist"
  ],
  "sideEffects": [
    "./dist/styles.css",
    "./dist/styles.min.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./pdf": {
      "types": "./dist/pdf.d.ts",
      "import": "./dist/pdf.js",
      "default": "./dist/pdf.js"
    },
    "./xlsx": {
      "types": "./dist/xlsx.d.ts",
      "import": "./dist/xlsx.js",
      "default": "./dist/xlsx.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js",
      "default": "./dist/client.js"
    },
    "./next": {
      "types": "./dist/next.d.ts",
      "import": "./dist/next.js",
      "default": "./dist/next.js"
    },
    "./styles.css": "./dist/styles.css",
    "./styles.min.css": "./dist/styles.min.css",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/build-styles.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "publint": "publint",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "changeset:publish": "changeset publish",
    "prepack": "npm run build",
    "prepublishOnly": "npm run typecheck && npm run lint && npm run test"
  },
  "peerDependencies": {
    "@react-pdf/renderer": ">=4.3",
    "cosmemilton-ui": ">=3.17",
    "exceljs": ">=4.4",
    "next": ">=15",
    "react": ">=18.2 || >=19",
    "react-dom": ">=18.2 || >=19"
  },
  "peerDependenciesMeta": {
    "@react-pdf/renderer": {
      "optional": true
    },
    "cosmemilton-ui": {
      "optional": true
    },
    "exceljs": {
      "optional": true
    },
    "next": {
      "optional": true
    }
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.3",
    "@changesets/cli": "^2.31.0",
    "@eslint/js": "^9.39.4",
    "@iconify/react": "^6.0.2",
    "@react-pdf/renderer": "^4.3.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/coverage-v8": "^4.1.7",
    "autoprefixer": "^10.5.0",
    "cosmemilton-ui": "^3.17.0",
    "cssnano": "^8.0.1",
    "eslint": "^9.39.4",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "exceljs": "^4.4.0",
    "globals": "^17.6.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.14",
    "prettier": "^3.8.3",
    "publint": "^0.3.21",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5",
    "typescript-eslint": "^8.60.0",
    "vitest": "^4.1.7"
  },
  "overrides": {
    "postcss": "^8.5.14"
  }
}
